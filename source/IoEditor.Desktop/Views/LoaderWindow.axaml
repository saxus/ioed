<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IoEditor.Desktop.Views.LoaderWindow"
        Title="Open stud.io files"
        Width="700" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource IoEditorChromeBackground}"
        Foreground="{DynamicResource IoEditorChromeForeground}">
  <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="6">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Reference File:" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceFile, Mode=TwoWay}" />
    <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Command="{Binding BrowseReferenceFileCommand}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target File:" VerticalAlignment="Center" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetFile, Mode=TwoWay}" />
    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Command="{Binding BrowseTargetFileCommand}" />

    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Open" Width="80" Command="{Binding OpenCommand}" />
      <Button Content="Cancel" Width="80" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
