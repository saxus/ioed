<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IoEditor.Desktop.ViewModels"
        xmlns:panels="using:IoEditor.Desktop.ViewModels.Panels"
        xmlns:panelViews="using:IoEditor.Desktop.Views.Panels"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        x:Class="IoEditor.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Title="{Binding WindowTitle}"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource IoEditorChromeBackground}"
        Foreground="{DynamicResource IoEditorChromeForeground}">

  <Grid ColumnDefinitions="52,*"
        Background="{DynamicResource IoEditorChromeBackground}">

    <!-- ================================================================
         Nav Rail (left 52 px column)
         ================================================================ -->
    <Border Grid.Column="0"
            Background="{DynamicResource IoEditorNavRailBackground}"
            BorderBrush="{DynamicResource IoEditorBorderBrush}"
            BorderThickness="0,0,1,0">
      <Border.Styles>
        <Style Selector="Button.navRailBtn">
          <Setter Property="Background" Value="{DynamicResource IoEditorNavButtonBackground}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Width" Value="52" />
          <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Button.navRailBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource IoEditorNavButtonBackgroundPointerOver}" />
        </Style>
      </Border.Styles>

      <Grid RowDefinitions="*,Auto">

        <!-- Open panels list (scrollable) -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding OpenPanels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.DataTemplates>

              <!-- Home panel -->
              <DataTemplate DataType="panels:StartPanelViewModel">
                <Grid Height="44">
                  <Border Width="3"
                          HorizontalAlignment="Left"
                          Background="{DynamicResource IoEditorNavRailSelectionAccent}"
                          IsVisible="{Binding IsActive}" />
                  <Button Classes="navRailBtn"
                          Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding Title}">
                    <Image Width="22" Height="22">
                      <Image.Source>
                        <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/nav-home.svg" />
                      </Image.Source>
                    </Image>
                  </Button>
                </Grid>
              </DataTemplate>

              <!-- Project panel -->
              <DataTemplate DataType="panels:ProjectPanelViewModel">
                <Grid Height="44">
                  <Border Width="3"
                          HorizontalAlignment="Left"
                          Background="{DynamicResource IoEditorNavRailSelectionAccent}"
                          IsVisible="{Binding IsActive}" />
                  <Button Classes="navRailBtn"
                          Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding Title}">
                    <Image Width="22" Height="22">
                      <Image.Source>
                        <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/nav-segments.svg" />
                      </Image.Source>
                    </Image>
                  </Button>
                </Grid>
              </DataTemplate>

            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>

        <!-- Fixed Settings button at the bottom -->
        <Grid Grid.Row="1" Height="44">
          <Border Width="3"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource IoEditorNavRailSelectionAccent}"
                  IsVisible="{Binding IsSettingsPanelActive}" />
          <Button Classes="navRailBtn"
                  Command="{Binding OpenSettingsPanelCommand}"
                  ToolTip.Tip="Settings">
            <Image Width="22" Height="22">
              <Image.Source>
                <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/nav-settings.svg" />
              </Image.Source>
            </Image>
          </Button>
        </Grid>

      </Grid>
    </Border>

    <!-- ================================================================
         Content area – resolved by DataTemplate per panel type
         ================================================================ -->
    <ContentControl Grid.Column="1"
                    Content="{Binding SelectedPanel}">
      <ContentControl.DataTemplates>

        <DataTemplate DataType="panels:StartPanelViewModel">
          <panelViews:StartPanelView />
        </DataTemplate>

        <DataTemplate DataType="panels:ProjectPanelViewModel">
          <panelViews:ProjectPanelView />
        </DataTemplate>

        <DataTemplate DataType="panels:SettingsPanelViewModel">
          <panelViews:SettingsPanelView />
        </DataTemplate>

      </ContentControl.DataTemplates>
    </ContentControl>

  </Grid>
</Window>
