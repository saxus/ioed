<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoEditor.Desktop.ViewModels.Panels"
             x:Class="IoEditor.Desktop.Views.Panels.SettingsPanelView"
             x:DataType="vm:SettingsPanelViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource IoEditorChromeBackground}">

  <UserControl.Styles>

    <!-- ── Settings nav list ── -->
    <Style Selector="ListBox.settingsNav">
      <Setter Property="Background" Value="{DynamicResource IoEditorNavRailBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.settingsNav ListBoxItem">
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ListBox.settingsNav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IoEditorNavButtonBackgroundPointerOver}" />
    </Style>

    <Style Selector="ListBox.settingsNav ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource IoEditorNavRailSelectionAccent}" />
    </Style>

    <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IoEditorSegmentRowBackgroundSelected}" />
    </Style>

    <!-- ── Section heading ── -->
    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource IoEditorMutedForeground}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ══ Toolbar ══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Background="{DynamicResource IoEditorSegmentsToolbarBackground}"
            BorderBrush="{DynamicResource IoEditorSegmentsToolbarBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding UndoCommand}"
                  IsEnabled="{Binding IsDirty}"
                  Padding="10,6">
            <TextBlock VerticalAlignment="Center" Text="Undo" />
          </Button>
          <Button Command="{Binding SaveCommand}" Padding="10,6">
            <TextBlock VerticalAlignment="Center" Text="Save" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ Main area ═════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="180,Auto,*">

      <!-- ── Left nav ───────────────────────────────────────────────────── -->
      <ListBox Grid.Column="0"
               Classes="settingsNav"
               ItemsSource="{Binding Sections}"
               SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />

      <!-- ── Separator ──────────────────────────────────────────────────── -->
      <Border Grid.Column="1"
              Width="1"
              Background="{DynamicResource IoEditorBorderBrush}" />

      <!-- ── Right content ──────────────────────────────────────────────── -->
      <ScrollViewer Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Panel>

          <!-- ═══ GENERAL ══════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsGeneralSelected}"
                      Margin="28,24" Spacing="24" MaxWidth="520">

            <!-- Theme -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionHeading" Text="Theme" />
              <ComboBox ItemsSource="{Binding ThemeModes}"
                        SelectedItem="{Binding ThemeMode, Mode=TwoWay}"
                        MinWidth="160" />
            </StackPanel>

            <!-- Debug -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionHeading" Text="Debug" />
              <CheckBox IsChecked="{Binding ShowXmlDebugTabs, Mode=TwoWay}"
                        Content="Show XML debug entries in the sidebar (reference, target, generated instruction, step dictionary)" />
              <TextBlock Opacity="0.55"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Text="When unchecked, those entries are hidden in the project panel section switcher." />
            </StackPanel>

          </StackPanel>

          <!-- ═══ STUDIO ═══════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsStudioSelected}"
                      Margin="28,24" Spacing="24" MaxWidth="520">

            <StackPanel Spacing="10">
              <TextBlock Classes="sectionHeading" Text="Studio" />
              <TextBlock Text="Studio Folder:" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding StudioFolderPath, Mode=TwoWay}"
                         IsReadOnly="True" />
                <Button Grid.Column="1"
                        Content="Browse…"
                        Command="{Binding BrowseStudioFolderCommand}" />
              </Grid>
            </StackPanel>

          </StackPanel>

          <!-- ═══ IMAGES ════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsImagesSelected}"
                      Margin="28,24" Spacing="24" MaxWidth="520">

            <!-- Image source selector -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionHeading" Text="Image Source" />
              <ComboBox ItemsSource="{Binding AvailableSources}"
                        SelectedItem="{Binding ActiveSource, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}"
                        MinWidth="200" />
            </StackPanel>

            <!-- Per-source cache info -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionHeading" Text="{Binding ActiveSource.Name}" />
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Cache size:" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CacheSizeMb, StringFormat={}{0:0.0} MB}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Clear cache"
                        Command="{Binding ClearCacheCommand}"
                        Padding="10,6" />
              </Grid>
            </StackPanel>

          </StackPanel>

          <!-- ═══ HOTKEYS ════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsHotkeysSelected}"
                      Margin="28,24"
                      Spacing="24"
                      MaxWidth="520">

            <TextBlock Classes="sectionHeading"
                       Text="Keyboard shortcuts" />

            <Grid ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="12">

              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         FontWeight="SemiBold"
                         Text="Ctrl+G / Cmd+G" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         TextWrapping="Wrap"
                         Text="Focus the Jump to page field (Segments view)" />

              <TextBlock Grid.Row="1"
                         Grid.Column="0"
                         FontWeight="SemiBold"
                         Text="Enter" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         TextWrapping="Wrap"
                         Text="Jump to the entered page in the Source file" />

              <TextBlock Grid.Row="2"
                         Grid.Column="0"
                         FontWeight="SemiBold"
                         Text="Shift+Enter" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         TextWrapping="Wrap"
                         Text="Jump to the entered page in the Target file" />

            </Grid>

          </StackPanel>

        </Panel>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>
