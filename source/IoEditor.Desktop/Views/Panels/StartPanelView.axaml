<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoEditor.Desktop.ViewModels.Panels"
             xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
             x:Class="IoEditor.Desktop.Views.Panels.StartPanelView"
             x:DataType="vm:StartPanelViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource IoEditorChromeBackground}">
  <Grid RowDefinitions="Auto,*">

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource IoEditorSegmentsToolbarBackground}"
            BorderBrush="{DynamicResource IoEditorSegmentsToolbarBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding OpenCommand}"
                Padding="10,6"
                Foreground="{DynamicResource IoEditorChromeForeground}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Width="16" Height="16">
              <Image.Source>
                <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/icon-open-folder.svg" />
              </Image.Source>
            </Image>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource IoEditorChromeForeground}"
                       Text="Open project…" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Welcome content -->
    <Grid Grid.Row="1">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="20">
        <TextBlock Text="IoEditor"
                   FontSize="36"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource IoEditorChromeForeground}" />
        <TextBlock Text="Compare and merge stud.io instruction files."
                   FontSize="14"
                   Opacity="0.7"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource IoEditorChromeForeground}" />
        <Button Command="{Binding OpenCommand}"
                HorizontalAlignment="Center"
                Padding="24,10"
                Foreground="{DynamicResource IoEditorChromeForeground}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="18" Height="18">
              <Image.Source>
                <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/icon-open-folder.svg" />
              </Image.Source>
            </Image>
            <TextBlock Text="Open project…"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource IoEditorChromeForeground}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
