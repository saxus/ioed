<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoEditor.Desktop.ViewModels.Panels"
             xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
             x:Class="IoEditor.Desktop.Views.Panels.StartPanelView"
             x:DataType="vm:StartPanelViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource IoEditorChromeBackground}">
  <Grid RowDefinitions="Auto,*">

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource IoEditorSegmentsToolbarBackground}"
            BorderBrush="{DynamicResource IoEditorSegmentsToolbarBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding OpenCommand}"
                Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Width="16" Height="16">
              <Image.Source>
                <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/icon-open-folder.svg" />
              </Image.Source>
            </Image>
            <TextBlock VerticalAlignment="Center"
                       Text="Open project…" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Recent projects content -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="24"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <TextBlock Text="Recent projects..."
                     FontSize="18"
                     FontWeight="SemiBold" />

          <ItemsControl ItemsSource="{Binding RecentProjects}"
                        IsVisible="{Binding HasRecentProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RecentProjectItemViewModel">
                <Border Margin="0,0,0,8"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource IoEditorPanelBackground}"
                        BorderBrush="{DynamicResource IoEditorBorderBrush}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Width="137"
                            Height="100"
                            Background="#1E1E1E"
                            CornerRadius="4"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                      <Grid>
                        <Image Source="{Binding ThumbnailImage}"
                               Stretch="Uniform"
                               IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Text="No preview"
                                   Foreground="#555555"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowThumbnailPlaceholder}" />
                      </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="14"
                                 TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="6">
                        <TextBlock Grid.Column="0"
                                   Text="⚠"
                                   Foreground="#D7B84A"
                                   IsVisible="{Binding ReferenceMissing}" />
                        <SelectableTextBlock Grid.Column="1"
                                             Text="{Binding ReferencePath}"
                                             FontSize="12"
                                             Opacity="0.65"
                                             TextWrapping="Wrap" />
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="6">
                        <TextBlock Grid.Column="0"
                                   Text="⚠"
                                   Foreground="#D7B84A"
                                   IsVisible="{Binding TargetMissing}" />
                        <SelectableTextBlock Grid.Column="1"
                                             Text="{Binding TargetPath}"
                                             FontSize="12"
                                             Opacity="0.65"
                                             TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Command="{Binding OpenCommand}"
                              Padding="8,5"
                              ToolTip.Tip="Open project">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Image Width="16" Height="16">
                            <Image.Source>
                              <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/icon-open-folder.svg" />
                            </Image.Source>
                          </Image>
                          <TextBlock Text="Open..."
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>

                      <Button Command="{Binding RemoveCommand}"
                              Padding="7,5"
                              ToolTip.Tip="Remove from recent projects">
                        <Image Width="16" Height="16">
                          <Image.Source>
                            <svg:SvgImage Source="avares://IoEditor.Desktop/Assets/Icons/icon-trash.svg" />
                          </Image.Source>
                        </Image>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

  </Grid>
</UserControl>
