<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IoEditor.Desktop.Views.SettingsWindow"
        Title="Io Editor settings"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="10">
    <TabControl Grid.Row="0">
      <TabItem Header="Studio Settings">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="10" RowSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Studio Folder:" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding StudioFolderPath, Mode=TwoWay}" IsReadOnly="True" Margin="0,0,8,0" />
          <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowseStudioFolderCommand}" />
          <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Content="Show XML debug tabs (reference / target / generated instruction, step dictionary)"
                    IsChecked="{Binding ShowXmlDebugTabs, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                     Opacity="0.75"
                     TextWrapping="Wrap"
                     Text="When unchecked, those tabs are hidden from the main window." />
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="OK" Width="80" Command="{Binding SaveCommand}" />
      <Button Content="Cancel" Width="80" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
